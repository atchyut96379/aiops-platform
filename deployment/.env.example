# Copy to .env and adjust values before: docker compose up --build
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars
APP_ENV=production
APP_NAME=AIOps Platform

# Azure VM example — replace with your public IP or domain
FRONTEND_URL=http://172.198.64.141
CORS_ORIGINS=http://172.198.64.141,http://localhost

# First login on a fresh database (optional; only runs when no users exist)
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User
BOOTSTRAP_ORG_NAME=My Organization

RATE_LIMIT_ENABLED=true
# Email (set EMAIL_ENABLED=true and SMTP_* for real delivery)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# AI (optional)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe billing (optional — demo upgrade when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# Postgres (used by docker-compose for db service)
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops
POSTGRES_DB=aiops
